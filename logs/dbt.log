  create view "dev"."main"."stg_geolocation__dbt_tmp" as (
    -- On agrège par zip_code_prefix car le seed brut contient plusieurs
-- lignes lat/lng pour un même code postal (doublons connus sur ce dataset).
-- Sans ce group by, toute jointure sur zip_code_prefix duplique les lignes.
select
    geolocation_zip_code_prefix as zip_code_prefix,
    avg(geolocation_lat) as latitude,
    avg(geolocation_lng) as longitude,
    max(geolocation_city) as city,
    max(geolocation_state) as state
from "dev"."main"."olist_geolocation_dataset"
group by geolocation_zip_code_prefix
  );

