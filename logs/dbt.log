),

final as (
    select
        o.order_id,
        o.customer_id,
        c.customer_unique_id,
        c.city,
        c.state,
        o.status,
        o.purchased_at,
        oi.product_id,
        oi.price,
        oi.freight_value
    from orders o
    left join customers c on o.customer_id = c.customer_id
    left join order_items oi on o.order_id = oi.order_id
)

select * from final
  );

