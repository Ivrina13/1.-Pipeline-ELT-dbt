  create view "dev"."main"."fct_orders__dbt_tmp" as (
    -- Grain de ce modèle : une ligne = une commande (order_id).
-- Les tables order_items, order_payments et order_reviews ont potentiellement
-- plusieurs lignes par commande : on les agrège AVANT de joindre pour ne pas
-- dupliquer les lignes de la commande.

with order_items_agg as (

    select
        order_id,
        count(*) as item_count,
        sum(price) as price,
        sum(freight_value) as freight_value
    from "dev"."main"."stg_order_items"
    group by order_id

),

payments_agg as (

    select
        order_id,
        sum(payment_value) as total_payment_value,
        count(*) as payment_count,
        max(payment_installments) as max_installments
    from "dev"."main"."stg_order_payments"
    group by order_id

),

reviews_agg as (

    select
        order_id,
        avg(score) as avg_review_score,
        count(*) as review_count
    from "dev"."main"."stg_order_reviews"
    group by order_id

),

orders as (

    select * from "dev"."main"."stg_orders"

),

customers as (

    select * from "dev"."main"."stg_customers"

)

select
    orders.order_id,
    orders.customer_id,
    customers.customer_unique_id,
    customers.city as customer_city,
    customers.state as customer_state,
    orders.status,
    orders.purchased_at,
    orders.approved_at,
    orders.shipped_at,
    orders.delivered_at,
    orders.estimated_delivery_at,

    -- volumétrie / montants de la commande (agrégés depuis order_items)
    coalesce(order_items_agg.item_count, 0) as item_count,
    coalesce(order_items_agg.price, 0) as price,
    coalesce(order_items_agg.freight_value, 0) as freight_value,

    -- paiements (agrégés : une commande peut avoir plusieurs moyens de paiement)
    coalesce(payments_agg.total_payment_value, 0) as total_payment_value,
    payments_agg.payment_count,
    payments_agg.max_installments,

    -- reviews (agrégées : rare mais une commande peut avoir plusieurs avis)
    reviews_agg.avg_review_score,
    reviews_agg.review_count

from orders
left join customers
    on orders.customer_id = customers.customer_id
left join order_items_agg
    on orders.order_id = order_items_agg.order_id
left join payments_agg
    on orders.order_id = payments_agg.order_id
left join reviews_agg
    on orders.order_id = reviews_agg.order_id
  );

